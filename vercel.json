{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/([^/]+)",
      "destination": "/api/redirect?alias=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
